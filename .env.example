# ---- Database ----
POSTGRES_USER=mundiuser
POSTGRES_PASSWORD=changeme
POSTGRES_DB=mundidb
POSTGRES_HOST=postgresdb
POSTGRES_PORT=5432

# ---- MinIO / S3 (local dev) ----
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=changeme
S3_ACCESS_KEY_ID=s3user
S3_SECRET_ACCESS_KEY=changeme
S3_DEFAULT_REGION=us-east-1
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=test-bucket

# ---- Cloudflare R2 (production) ----
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=<r2-access-key>
# S3_SECRET_ACCESS_KEY=<r2-secret-key>
# S3_BUCKET=mundi-layers
# S3_DEFAULT_REGION=auto

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
# Optional local fallback when Docker Desktop cannot pull redis:alpine.
# REDIS_IMAGE=mundi-redis:local

# ---- Clerk authentication ----
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_ISSUER=

# ---- OpenAI / LLM ----
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-nano

# Hermes planner for complex Sage turns: 0 (default) uses the hand-rolled loop;
# `auto` enables Hermes only when OPENROUTER_API_KEY is set (Hermes is configured
# with provider=openrouter). Tool callbacks need MUNDI_TOOL_CALL_ENABLED=1.
# Deterministic admin and FastSAM workflows still run first.
MUNDI_USE_HERMES=0
MUNDI_TOOL_CALL_ENABLED=0
# Per-turn tool shortlist: send only the K most relevant tools (keyword + local
# nomic-embed-text ranking over the full catalog). 0 = off (current routing).
# Enable only after the routing eval shows a gain (evals/sage_routing).
SAGE_TOOL_SHORTLIST_K=0
# Abdication guard: when the first answer of a turn is prose although the
# request needs a tool, retry once forcing a tool over the 5 best-ranked
# tools. Off until the routing eval shows a gain.
SAGE_ABDICATION_GUARD=0
# Sage flight recorder: one self-hosted Langfuse trace per Sage turn
# (routing, shortlist, model calls, tools, guard; problem turns tagged).
# Empty keys = off. `python scripts/setup_langfuse.py` fills these and the
# Langfuse service secrets; then `docker compose --profile langfuse up -d`.
# UI at http://localhost:3100.
LANGFUSE_HOST=http://langfuse-web:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_TRACING_ENVIRONMENT=local
# Optional: lowers the FastSAM sample cap (src/services/raster_object_candidates.py
# DEFAULT_MAX_SAMPLE_PIXELS); it cannot raise it.
MUNDI_RASTER_OBJECT_MAX_SAMPLE_PIXELS=
UVICORN_WORKERS=1
MUNDI_BACKGROUND_WORKERS_ENABLED=1

# ---- Sentinel Hub (Planet Labs integration) ----
SH_CLIENT_ID=
SH_CLIENT_SECRET=

# ---- OpenEO ----
OPENEO_CLIENT_ID=
OPENEO_CLIENT_SECRET=

# ---- Copernicus CDS ----
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=

# ---- Frontend build args ----
VITE_WEBSITE_DOMAIN=http://localhost:8000
VITE_CLERK_PUBLISHABLE_KEY=
VITE_CLERK_SIGN_IN_URL=
VITE_CLERK_SIGN_UP_URL=
VITE_POSTHOG_KEY=phc_W7tOZXWc5oPtpiYyyINii49GodL1NgyS6z30pNW8aTP
VITE_POSTHOG_HOST=https://us.i.posthog.com

# ---- Observability ----
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=ingabe

# ---- Rate limiting ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_EXPENSIVE=20/minute
RATE_LIMIT_HEAVY=10/minute
RATE_LIMIT_GENERAL=120/minute

# ---- Database backups ----
BACKUP_RETENTION_DAYS=7
BACKUP_CRON=0 2 * * *

# ---- Superset ----
SUPERSET_SECRET_KEY=changeme
