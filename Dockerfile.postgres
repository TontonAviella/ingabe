FROM postgis/postgis:15-3.4

# Install pgvector for brain_content_chunks embedding search (HNSW index).
# The base image is Debian 11 (bullseye, EOL): apt.postgresql.org moved
# bullseye-pgdg to apt-archive.postgresql.org and now returns 404, so point the
# existing pgdg source (keeping its signed-by key) at the archive. Same
# PostgreSQL 15 + PostGIS 3.4; moving to a newer base image would upgrade the
# PostGIS extension and belongs in its own change.
RUN sed -i -E \
       's#http://apt\.postgresql\.org/pub/repos/apt/? bullseye-pgdg main.*#https://apt-archive.postgresql.org/pub/repos/apt bullseye-pgdg-archive main#' \
       /etc/apt/sources.list.d/pgdg.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
       postgresql-15-pgvector \
    && rm -rf /var/lib/apt/lists/*
