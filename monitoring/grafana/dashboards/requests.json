{
 "uid": "ingabe-requests",
 "title": "Requests",
 "description": "Every request traced: which route is slow or failing, and inside one request, which query or outside call took the time. Browser errors and slow database queries too.",
 "tags": [
  "ingabe-health",
  "requests"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "refresh": "1m",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Requests, last hour",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(increase(traces_spanmetrics_calls_total{span_kind=\"SPAN_KIND_SERVER\"}[1h]))",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     },
     "mappings": [],
     "decimals": 0
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value_and_name"
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Server errors, last hour",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(increase(traces_spanmetrics_calls_total{span_kind=\"SPAN_KIND_SERVER\",status_code=\"STATUS_CODE_ERROR\"}[1h])) or vector(0)",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     },
     "mappings": [],
     "decimals": 0
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value_and_name"
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Slowest route, 1 in 20 (s)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max(histogram_quantile(0.95, sum by (span_name, le) (rate(traces_spanmetrics_latency_bucket{span_kind=\"SPAN_KIND_SERVER\",span_name!~\".*upload.*\"}[1h]))))",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 5
       },
       {
        "color": "red",
        "value": 10
       }
      ]
     },
     "mappings": [],
     "decimals": 1
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value_and_name"
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Errors in browsers, last hour",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(increase(frontend_errors_total[1h])) or vector(0)",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       },
       {
        "color": "red",
        "value": 10
       }
      ]
     },
     "mappings": [],
     "decimals": 0
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value_and_name"
   }
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Time per route, 1 in 20 requests (s)",
   "description": "Each line is a page or API route; the slowest ten. Click a point to see example traces (exemplars).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "topk(10, histogram_quantile(0.95, sum by (span_name, le) (rate(traces_spanmetrics_latency_bucket{span_kind=\"SPAN_KIND_SERVER\"}[10m]))))",
     "legendFormat": "{{span_name}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Server errors per route",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (span_name) (increase(traces_spanmetrics_calls_total{span_kind=\"SPAN_KIND_SERVER\",status_code=\"STATUS_CODE_ERROR\"}[10m])) > 0",
     "legendFormat": "{{span_name}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 7,
   "type": "table",
   "title": "Routes, last 24 hours: calls",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 13,
    "w": 24,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sort_desc(sum by (span_name) (increase(traces_spanmetrics_calls_total{span_kind=\"SPAN_KIND_SERVER\"}[24h])))",
     "instant": true,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true,
       "Value": true,
       "alertstate": true,
       "instance": true
      },
      "renameByName": {
       "span_name": "Route",
       "Value": "Calls"
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "showHeader": true
   }
  },
  {
   "id": 8,
   "type": "table",
   "title": "Slowest requests, last 24 hours (click one to see every query and outside call)",
   "description": "Each trace shows where the time went: database queries (asyncpg), outside calls (httpx, requests) and Sage's turn.",
   "datasource": {
    "type": "tempo",
    "uid": "tempo"
   },
   "gridPos": {
    "x": 0,
    "y": 21,
    "w": 24,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "tempo",
      "uid": "tempo"
     },
     "queryType": "traceql",
     "query": "{ kind = server && duration > 2s }",
     "limit": 30,
     "tableType": "traces"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "showHeader": true
   }
  },
  {
   "id": 9,
   "type": "table",
   "title": "Failed requests (click one for the step that failed, then its log lines)",
   "description": "",
   "datasource": {
    "type": "tempo",
    "uid": "tempo"
   },
   "gridPos": {
    "x": 0,
    "y": 30,
    "w": 24,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "tempo",
      "uid": "tempo"
     },
     "queryType": "traceql",
     "query": "{ kind = server && status = error }",
     "limit": 30,
     "tableType": "traces"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "showHeader": true
   }
  },
  {
   "id": 10,
   "type": "table",
   "title": "Slow calls to outside services (AI model, Digital Earth Africa, CHIRPS...)",
   "description": "",
   "datasource": {
    "type": "tempo",
    "uid": "tempo"
   },
   "gridPos": {
    "x": 0,
    "y": 39,
    "w": 24,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "tempo",
      "uid": "tempo"
     },
     "queryType": "traceql",
     "query": "{ kind = client && duration > 5s }",
     "limit": 30,
     "tableType": "traces"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "showHeader": true
   }
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Database time by query (s per minute)",
   "description": "The query text for each id is on the Ingabe Health page (Slowest database queries).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 48,
    "w": 24,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "topk(8, sum by (queryid) (rate(pg_stat_statements_seconds_total{datname=\"mundidb\"}[10m])) * 60)",
     "legendFormat": "query {{queryid}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 12,
   "type": "logs",
   "title": "Errors in people's browsers",
   "description": "",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 56,
    "w": 24,
    "h": 10
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "{container=\"mundi-app\"} |= \"src.browser_errors\""
    }
   ],
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending",
    "enableLogDetails": true,
    "prettifyLogMessage": false,
    "dedupStrategy": "none"
   }
  }
 ],
 "links": [
  {
   "title": "Ingabe health dashboards",
   "type": "dashboards",
   "tags": [
    "ingabe-health"
   ],
   "asDropdown": true
  }
 ]
}