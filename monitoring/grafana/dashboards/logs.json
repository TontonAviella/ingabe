{
 "uid": "ingabe-logs",
 "title": "Logs",
 "description": "Every container's logs. Pick a container; search with the box.",
 "tags": [
  "ingabe-health",
  "logs"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "refresh": "1m",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "logs",
   "title": "Logs",
   "description": "",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 24
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "{container=~\"$container\"} |~ \"(?i)$search\""
    }
   ],
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending",
    "enableLogDetails": true,
    "prettifyLogMessage": false,
    "dedupStrategy": "none"
   }
  }
 ],
 "links": [
  {
   "title": "Ingabe health dashboards",
   "type": "dashboards",
   "tags": [
    "ingabe-health"
   ],
   "asDropdown": true
  }
 ],
 "templating": {
  "list": [
   {
    "name": "container",
    "type": "query",
    "datasource": {
     "type": "loki",
     "uid": "loki"
    },
    "query": {
     "label": "container",
     "type": 1,
     "refId": "LokiVariableQueryEditor-VariableQuery"
    },
    "definition": "label_values(container)",
    "includeAll": true,
    "multi": true,
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "refresh": 2
   },
   {
    "name": "search",
    "type": "textbox",
    "label": "Search (regex)",
    "query": "",
    "current": {
     "text": "",
     "value": ""
    }
   }
  ]
 }
}