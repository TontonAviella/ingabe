  {
   "id": 14,
   "type": "logs",
   "title": "Errors in any container (last hour)",
   "description": "",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 24,
    "h": 12
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "{level=~\"ERROR|CRITICAL\"}"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "{container!=\"mundi-app\", container=~\".+\"} |~ \"(?i)\\\\b(error|fatal|panic|exception)\\\\b\" !~ \"level=info\""
    }
   ],
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending",
    "enableLogDetails": true,
    "prettifyLogMessage": false,
    "dedupStrategy": "none"
   }
