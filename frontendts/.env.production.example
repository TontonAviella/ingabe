# Production build env vars — baked into the SPA at `npm run build` time.
# Copy to .env.production on the build host (CI or deploy box). NEVER commit
# a real .env.production: pk_test_ keys leak the dev Clerk instance into prod
# (Clerk shows "My Application" + "Development mode" badge + closing-moccasin-11.accounts.dev).

VITE_WEBSITE_DOMAIN=https://gis.nozalabs.rw

# MUST be a pk_live_* key from the production Clerk instance.
# pk_test_* in prod triggers Clerk's dev-mode rate limits and unbranded UI.
VITE_CLERK_PUBLISHABLE_KEY=pk_live_REPLACE_ME

# Satellite mode: when set, mundi.ai redirects sign-in to the primary domain
# (noza-web on Vercel). Leave blank to use Clerk's hosted UI directly.
VITE_CLERK_SIGN_IN_URL=https://nozalabs.rw/sign-in
VITE_CLERK_SIGN_UP_URL=https://nozalabs.rw/sign-up

VITE_POSTHOG_KEY=phc_REPLACE_ME
VITE_POSTHOG_HOST=https://us.i.posthog.com
