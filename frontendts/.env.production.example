# Production build environment for the Vite-built SPA.
#
# WARNING: Vite bakes VITE_* values into the compiled JS bundle at build
# time. Whatever you put here ends up in production users' browsers.
# Never put secrets in here.
#
# Copy this file to frontendts/.env.production on the local build machine before
# `npm run build`. The .env.production file is gitignored and stays
# host-local.

VITE_WEBSITE_DOMAIN=http://localhost:8000

# Sign-in provider. "workos" turns on WorkOS sign-in (the backend needs
# AUTH_PROVIDER=workos and the WORKOS_* keys, see .env.example); empty means
# no sign-in (the backend's MUNDI_AUTH_MODE decides).
VITE_AUTH_PROVIDER=workos

# The Noza Labs website (noza-web). The app's sidebar footer links to it; empty
# leaves the footer as plain text.
VITE_NOZA_SITE_URL=

# PostHog product-analytics key (project key, safe to expose — distinct
# from the admin pk_phx_* personal API key which must NEVER be in here).
VITE_POSTHOG_KEY=phc_REPLACE_ME
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Mapbox / MapTiler / etc. — none in default mundi.ai builds, add per partner.
